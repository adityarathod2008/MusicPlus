{
  "version": 2,
  "builds": [
    {
      "src": "backend/app.py",
      "use": "@vercel/python"
    },
    {
      "src": "**/*.html",
      "use": "@vercel/static"
    },
    {
      "src": "**/*.css",
      "use": "@vercel/static"
    },
    {
      "src": "**/*.js",
      "use": "@vercel/static"
    }
  ],
  "rewrites": [
    { "source": "/", "destination": "/music_app.html" }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/backend/app.py"
    },
    {
      "src": "/search",
      "dest": "/backend/app.py"
    },
    {
      "src": "/download/(.*)",
      "dest": "/backend/app.py"
    },
    {
      "src": "/stream/(.*)",
      "dest": "/backend/app.py"
    }
  ]
}
